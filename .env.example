# Optional: InfiniSynapse API key for richer AI narration + Q&A.
# Get one free at https://app.infinisynapse.com (new keys receive 500 credits).
# Without it, the app uses the offline heuristic narrator (clearly labeled).
INFINI_API_KEY=
# Overseas base URL (default). Use https://app.infinisynapse.cn for mainland China.
INFINI_BASE_URL=https://app.infinisynapse.com
# --- Free LLM fallback (see LLM_SETUP.md — 5 min setup, NO credit card) ---
# Used when no InfiniSynapse key is set. Groq first, then Gemini.
# Groq: https://console.groq.com -> API Keys -> Create (free tier, no card)
# GROQ_API_KEY=
# Backup — Google AI Studio: https://aistudio.google.com -> Get API Key (free, no card)
# GEMINI_API_KEY=
